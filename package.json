{
  "name": "riden-desktop",
  "productName": "RIDEN Desktop",
  "version": "0.1.0",
  "description": "RIDEN 可调电源上位机",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "test": "node --test tests/*.test.cjs",
    "core:linux": "cmake -S core -B core/build -DCMAKE_BUILD_TYPE=Release && cmake --build core/build && cmake --install core/build --prefix core/dist/linux",
    "core:win": "cmake -S core -B core/build-windows -DCMAKE_BUILD_TYPE=Release -DCMAKE_TOOLCHAIN_FILE=cmake/mingw-w64-x86_64.cmake && cmake --build core/build-windows && cmake --install core/build-windows --prefix core/dist/windows",
    "start": "vite build && electron .",
    "dist:linux": "vite build && electron-builder --linux",
    "dist:win": "vite build && electron-builder --win",
    "mock": "python3 scripts/mock-device.py"
  },
  "build": {
    "appId": "io.riden.desktop",
    "productName": "RIDEN Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "extraResources": [
        {
          "from": "core/dist/linux",
          "to": "core",
          "filter": [
            "bin/**",
            "lib/**"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "core/dist/windows",
          "to": "core",
          "filter": [
            "bin/*.exe",
            "bin/*.dll"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lucide/vue": "^1.66.0",
    "@material/material-color-utilities": "^0.4.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "echarts": "^6.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5",
    "vue": "^3.5.44"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/riden-tools/RIDEN-Desktop.git"
  }
}
